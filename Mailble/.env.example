# メール送信設定のサンプル
#
# このファイルを .env にコピーして、実際の値を設定してください。
# .env は .gitignore の対象なのでコミットされません。
#
#   cp Mailble/.env.example .env

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls

# 送信元アカウント
# Gmail の場合は通常のログインパスワードではなく
# 「アプリパスワード」を発行して設定してください。
MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# キューの設定
# メール送信をキュー経由にする場合に使用します。
QUEUE_CONNECTION=database
